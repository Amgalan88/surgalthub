NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-only, bypasses RLS. Used by the admin panel to
# look up user emails and generate passwords. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary - used by the admin panel to upload lesson media (image/video/audio/PDF)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public address of the site, e.g. https://cargohub.mn. Used for canonical
# URLs, the sitemap and the links in sign-up / password-reset emails.
# Also add it under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=https://your-domain.mn

# How learners reach you after paying or when stuck. Leave any empty to hide it.
NEXT_PUBLIC_SUPPORT_MESSENGER_URL=https://m.me/your-page
NEXT_PUBLIC_SUPPORT_PHONE=99112233
NEXT_PUBLIC_SUPPORT_EMAIL=info@your-domain.mn
